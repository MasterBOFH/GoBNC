{
  // TLS listener for IRC clients (prefer localhost on shared hosts).
  "listen_addr": "127.0.0.1:6697",
  "tls_cert": "certs/server.crt",
  "tls_key": "certs/server.key",

  // Certificate GoBNC presents when connecting to IRC networks (CERTFP / SASL EXTERNAL).
  // Empty = none. Per-network --tls-cert=/--tls-key= override; none or - disables for one network.
  "tls_client_cert": "",
  "tls_client_key": "",

  // Local address for outbound IRC connections (IP or hostname). Empty = OS default.
  // Per-network --bind-host= overrides; none or - disables for one network.
  "bind_host": "",

  // SQLite DB (mode 0600 enforced). Holds auth, networks, SASL secrets, history.
  "db_path": "gobnc.db",

  // Unix control socket for live network add/stop/reload/rehash/shutdown.
  // Empty (or legacy "gobnc.sock") → $XDG_RUNTIME_DIR/gobnc/gobnc.sock or ~/.gobnc/gobnc.sock.
  // Parent dir 0700, socket 0600; same-UID peers only.
  "control_socket": "",

  // PID file for daemon mode / gobnc stop. Empty → same state dir as control_socket.
  "pid_file": "",

  "log_level": "info", // debug | info | warn | error
  "log_file": "",      // optional JSON log path (0600); empty = no file (daemon mode defaults to state dir)

  // Max concurrent TLS client connections (0 uses default 32).
  "max_clients": 32,

  // Downlink client keepalive probe: after this many seconds of silence
  // from a client, gobnc sends it a PING; if it doesn't reply within the
  // grace period, gobnc closes the connection. 0 uses the built-in
  // defaults (300s / 120s). Raise these if a client's own periodic ping
  // (e.g. mIRC's timeout check) runs on a longer interval than that.
  "ping_idle_seconds": 0,
  "ping_grace_seconds": 0,

  // Max lines waiting in the paced uplink send queue (0 = unlimited).
  // Raised high by default so reconnect/catch-up bursts are not rejected early.
  "max_flood_queue": 16384,

  // Max PRIVMSG/NOTICE lines replayed per channel/query on legacy attach (0 = unlimited).
  "legacy_playback_max": 50000,

  // Max lines per CHATHISTORY query; advertised as ISUPPORT CHATHISTORY=N (default 100).
  // Not the same as legacy_playback_max (attach backlog for non-CHATHISTORY clients).
  "chathistory_max": 100,

  // Delete stored messages older than N days (0 = never prune).
  "history_retention_days": 0,

  // How incoming CTCP requests (PING, VERSION, or anything else
  // CTCP-framed, whether sent to our own nick or a channel we're in) are
  // handled: "relay" forwards live to attached downlinks unchanged
  // (default); "edge" answers directly from the bouncer over the uplink
  // instead of relaying; "disable" drops the request, no reply from
  // anyone. ctcp_other has no "edge" option. CTCP requests are never
  // stored for chathistory/legacy replay, regardless of mode. ACTION
  // (/me) and CTCP-framed NOTICE (a reply, not a request) always relay
  // untouched.
  "ctcp_ping": "relay",
  "ctcp_version": "relay",
  "ctcp_other": "relay",

  // QUIT reason sent to all uplinks on process shutdown.
  "quit_message": "GoBNC 0.1.1",

  // Defaults for `network add` when nick / identity flags are omitted.
  "default_nick": "",
  "default_username": "gobnc",
  "default_realname": "GoBNC",
  "default_alt_nick": "",

  // At least one auth mode must be true.
  "allow_password_auth": true,
  "allow_cert_auth": true,

  // Source IPs allowed to connect at all (CIDR, e.g. "10.0.0.0/8", or a
  // bare IP for a single host). Empty = unrestricted (default). Enforced
  // before the TLS handshake, let alone PASS/NICK/USER; a rejected IP is
  // logged at info level ("connection refused: ip not allowed") for
  // wiring into fail2ban or similar.
  "allowed_ips": []
}
